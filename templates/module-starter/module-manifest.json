    "smoothFollow": true,
    "mirrors": ["theme", "details", "controls", "images", "audio", "video", "youtube", "steppers", "timeline", "timer"]
  },
  "feedback": {
    "enabled": true,
    "endpoint": "/api/teacher-platform/feedback.php",
    "registry": "server/feedback-registry.php",
    "storesStudentAnswers": false,
    "tasks": [
      { "id": "spannung-zusammenfassen", "operator": "zusammenfassen", "afb": "I", "track": "Basis" },
      { "id": "spannung-analysieren", "operator": "analysieren", "afb": "II", "track": "Basis" },
      { "id": "spannung-gestalten", "operator": "gestalten und begründen", "afb": "III", "track": "Vertiefung" }
    ]
  },
  "privacy": {
    "noticeUrl": "/datenschutz-lernplattform/",
    "localStudentWork": true,
    "serverStoresStudentAnswers": false,
    "anonymousRoomState": true
  },
  "rights": { "publicationStatus": "cleared", "inventory": "RIGHTS.md" },
  "qa": {
    "viewports": ["360x800", "768x1024", "1366x768", "1920x1080"],
    "requiredChecks": ["manifest", "learningHtml", "viewBundle", "classroomContract", "liveBrowser", "accessibility", "rights", "hashes", "backupRestore"]
