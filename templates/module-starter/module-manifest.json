    "subject": "Musik",
    "grade": "10",
    "language": "de-DE",
    "status": "draft"
  },
  "curriculum": {
    "jurisdiction": "Bayern",
    "framework": "LehrplanPLUS Musik",
    "version": "bei Projektbeginn prüfen",
    "tracks": ["Basis", "Vertiefung"]
  },
  "versions": {
    "content": "0.1.0",
    "classroomCore": "1.3.1",
    "presentationCore": "1.2.5",
    "teacherPlatform": "1.0.1",
    "moduleAdapter": "1.0.0"
  },
  "routes": {
    "student": "/bereiche/musik-10/spannung/",
    "teacher": "/bereiche/musik-10/spannung/lehrer/",
