  },
  "build": {
    "source": "src/author.html",
    "output": "dist",
    "student": "dist/index.html",
    "teacher": "dist/lehrer/index.html",
    "beamer": "dist/beamer.html",
    "liveApi": "dist/api/live.php",
    "assetVersion": "starter-0.1.0"
